<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="reservation.reservation.controller.RespoController"
            style="-fx-background-color: linear-gradient(to bottom right, #003161, #000B58);">

    <!-- ===== HEADER ===== -->
    <top>
        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 30 0 20 0;">
            <Rectangle width="60" height="4" arcWidth="5" arcHeight="5"
                       fill="#006A67" style="-fx-effect: dropshadow(gaussian, #006A67, 10, 0.3, 0, 0);"/>
            <Label text="Dashboard Responsable"
                   style="-fx-text-fill: #FDEB9E; -fx-font-size: 28px; -fx-font-weight: bold;">
                <font>
                    <Font name="System Bold" size="28"/>
                </font>
            </Label>
            <HBox spacing="15" alignment="CENTER">
                <Button text="Profil" onAction="#showProfile" styleClass="nav-button"
                        style="
                -fx-background-color: linear-gradient(to right, #4CAF50, #388E3C);
                -fx-text-fill: white;
                -fx-font-weight: bold;
                -fx-background-radius: 8;
                -fx-padding: 10 30;
                -fx-cursor: hand;
                -fx-effect: dropshadow(gaussian, rgba(76, 175, 80, 0.4), 10, 0.3, 0, 2);"/>
                <Button text="Déconnexion" onAction="#handleLogout" styleClass="nav-button"
                        style="
                -fx-background-color: linear-gradient(to right, #4CAF50, #388E3C);
                -fx-text-fill: white;
                -fx-font-weight: bold;
                -fx-background-radius: 8;
                -fx-padding: 10 30;
                -fx-cursor: hand;
                -fx-effect: dropshadow(gaussian, rgba(76, 175, 80, 0.4), 10, 0.3, 0, 2);"/>
            </HBox>
            <Label text="Gérez vos salles et réservations"
                   style="-fx-text-fill: rgba(253, 235, 158, 0.8); -fx-font-size: 14px;"/>
        </VBox>
    </top>

    <!-- ===== CENTER avec scroll ===== -->
    <center>
        <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER"
                    style="-fx-background: transparent; -fx-border-color: transparent;">
            <content>
                <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 0 40 40 40;">

                    <!-- ================= SALLES ================= -->
                    <VBox spacing="15" style="
                         -fx-background-color: rgba(255, 255, 255, 0.95);
                         -fx-background-radius: 15;
                         -fx-padding: 25;
                         -fx-effect: dropshadow(gaussian, rgba(0, 11, 88, 0.3), 25, 0.2, 0, 5);
                         -fx-border-radius: 15;
                         -fx-border-color: #FDEB9E;
                         -fx-border-width: 1;">

                        <Label text="Mes salles"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #003161;"/>

                        <TableView fx:id="tableSalles" prefHeight="200" style="
                            -fx-background-color: white;
                            -fx-background-radius: 8;
                            -fx-border-radius: 8;
                            -fx-border-color: #ccc;
                            -fx-border-width: 1.5;">

                            <columns>
                                <TableColumn text="ID" prefWidth="60">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="id"/>
                                    </cellValueFactory>
                                </TableColumn>

                                <TableColumn text="Type" prefWidth="150">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="typeSalle"/>
                                    </cellValueFactory>
                                </TableColumn>

                                <TableColumn text="Capacité" prefWidth="100">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="capacite"/>
                                    </cellValueFactory>
                                </TableColumn>

                                <TableColumn text="Étage" prefWidth="80">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="numEtage"/>
                                    </cellValueFactory>
                                </TableColumn>

                                <TableColumn text="Prix" prefWidth="100">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="prix"/>
                                    </cellValueFactory>
                                </TableColumn>

                                <TableColumn text="Disponible" prefWidth="120">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="dispo"/>
                                    </cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>

                        <HBox spacing="10" alignment="CENTER">
                            <Button text="Ajouter Salle" onAction="#ajouterSalle" style="
                                -fx-background-color: linear-gradient(to right, #006A67, #003161);
                                -fx-text-fill: white;
                                -fx-font-weight: bold;
                                -fx-background-radius: 8;
                                -fx-padding: 10 20;
                                -fx-cursor: hand;
                                -fx-effect: dropshadow(gaussian, rgba(0, 106, 103, 0.4), 10, 0.3, 0, 2);"
                                    prefWidth="140"/>

                            <Button text="Modifier Salle" onAction="#modifierSalle" style="
                                -fx-background-color: linear-gradient(to right, #FFC107, #FF9800);
                                -fx-text-fill: #003161;
                                -fx-font-weight: bold;
                                -fx-background-radius: 8;
                                -fx-padding: 10 20;
                                -fx-cursor: hand;
                                -fx-effect: dropshadow(gaussian, rgba(255, 193, 7, 0.4), 10, 0.3, 0, 2);"
                                    prefWidth="140"/>

                            <Button text="Supprimer Salle" onAction="#supprimerSalle" style="
                                -fx-background-color: linear-gradient(to right, #F44336, #D32F2F);
                                -fx-text-fill: white;
                                -fx-font-weight: bold;
                                -fx-background-radius: 8;
                                -fx-padding: 10 20;
                                -fx-cursor: hand;
                                -fx-effect: dropshadow(gaussian, rgba(244, 67, 54, 0.4), 10, 0.3, 0, 2);"
                                    prefWidth="140"/>

                            <Button text="Changer disponibilité" onAction="#changerDisponibilite" style="
                                -fx-background-color: linear-gradient(to right, #2196F3, #1976D2);
                                -fx-text-fill: white;
                                -fx-font-weight: bold;
                                -fx-background-radius: 8;
                                -fx-padding: 10 20;
                                -fx-cursor: hand;
                                -fx-effect: dropshadow(gaussian, rgba(33, 150, 243, 0.4), 10, 0.3, 0, 2);"
                                    prefWidth="180"/>
                        </HBox>

                        <!-- ===== Formulaire Salle ===== -->
                        <VBox spacing="15" style="
                            -fx-background-color: rgba(240, 240, 240, 0.9);
                            -fx-background-radius: 10;
                            -fx-padding: 20;
                            -fx-border-radius: 10;
                            -fx-border-color: #006A67;
                            -fx-border-width: 1;">

                            <Label fx:id="salleFormTitle" text="Formulaire Salle"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #003161;"/>

                            <GridPane hgap="10" vgap="15">
                                <Label text="Type" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                       style="-fx-text-fill: #003161; -fx-font-weight: bold;"/>
                                <TextField fx:id="salleTypeField" GridPane.rowIndex="0" GridPane.columnIndex="1" style="
                                    -fx-background-color: white;
                                    -fx-background-radius: 8;
                                    -fx-border-radius: 8;
                                    -fx-border-color: #ccc;
                                    -fx-border-width: 1.5;
                                    -fx-padding: 8 12;
                                    -fx-pref-height: 35;"/>

                                <Label text="Capacité" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                       style="-fx-text-fill: #003161; -fx-font-weight: bold;"/>
                                <TextField fx:id="salleCapaciteField" GridPane.rowIndex="1" GridPane.columnIndex="1" style="
                                    -fx-background-color: white;
                                    -fx-background-radius: 8;
                                    -fx-border-radius: 8;
                                    -fx-border-color: #ccc;
                                    -fx-border-width: 1.5;
                                    -fx-padding: 8 12;
                                    -fx-pref-height: 35;"/>

                                <Label text="Num étage" GridPane.rowIndex="2" GridPane.columnIndex="0"
                                       style="-fx-text-fill: #003161; -fx-font-weight: bold;"/>
                                <TextField fx:id="salleNumEtageField" GridPane.rowIndex="2" GridPane.columnIndex="1" style="
                                    -fx-background-color: white;
                                    -fx-background-radius: 8;
                                    -fx-border-radius: 8;
                                    -fx-border-color: #ccc;
                                    -fx-border-width: 1.5;
                                    -fx-padding: 8 12;
                                    -fx-pref-height: 35;"/>

                                <Label text="Prix" GridPane.rowIndex="3" GridPane.columnIndex="0"
                                       style="-fx-text-fill: #003161; -fx-font-weight: bold;"/>
                                <TextField fx:id="sallePrixField" GridPane.rowIndex="3" GridPane.columnIndex="1" style="
                                    -fx-background-color: white;
                                    -fx-background-radius: 8;
                                    -fx-border-radius: 8;
                                    -fx-border-color: #ccc;
                                    -fx-border-width: 1.5;
                                    -fx-padding: 8 12;
                                    -fx-pref-height: 35;"/>

                                <Label text="Étage (FK)" GridPane.rowIndex="4" GridPane.columnIndex="0"
                                       style="-fx-text-fill: #003161; -fx-font-weight: bold;"/>
                                <ComboBox fx:id="salleEtageCombo" GridPane.rowIndex="4" GridPane.columnIndex="1" style="
                                    -fx-background-color: white;
                                    -fx-background-radius: 8;
                                    -fx-border-radius: 8;
                                    -fx-border-color: #ccc;
                                    -fx-border-width: 1.5;
                                    -fx-pref-height: 35;"/>

                                <CheckBox fx:id="salleDispoCheck" text="Disponible"
                                          GridPane.rowIndex="5" GridPane.columnIndex="1"
                                          style="-fx-text-fill: #003161; -fx-font-weight: bold;"/>
                            </GridPane>

                            <HBox spacing="10" alignment="CENTER">
                                <Button text="Enregistrer" onAction="#enregistrerSalle" style="
                                    -fx-background-color: linear-gradient(to right, #006A67, #003161);
                                    -fx-text-fill: white;
                                    -fx-font-weight: bold;
                                    -fx-background-radius: 8;
                                    -fx-padding: 10 30;
                                    -fx-cursor: hand;
                                    -fx-effect: dropshadow(gaussian, rgba(0, 106, 103, 0.4), 10, 0.3, 0, 2);"
                                        prefWidth="140"/>

                                <Button text="Annuler" onAction="#annulerEditionSalle" style="
                                    -fx-background-color: #cccccc;
                                    -fx-text-fill: #003161;
                                    -fx-font-weight: bold;
                                    -fx-background-radius: 8;
                                    -fx-padding: 10 30;
                                    -fx-cursor: hand;"
                                        prefWidth="140"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <Separator style="-fx-background-color: rgba(253, 235, 158, 0.3); -fx-padding: 10 0;"/>

                    <!-- ================= RESERVATIONS ================= -->
                    <VBox spacing="15" style="
                         -fx-background-color: rgba(255, 255, 255, 0.95);
                         -fx-background-radius: 15;
                         -fx-padding: 25;
                         -fx-effect: dropshadow(gaussian, rgba(0, 11, 88, 0.3), 25, 0.2, 0, 5);
                         -fx-border-radius: 15;
                         -fx-border-color: #FDEB9E;
                         -fx-border-width: 1;">

                        <Label text="Réservations"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #003161;"/>

                        <TableView fx:id="tableReservations" prefHeight="200" style="
                            -fx-background-color: white;
                            -fx-background-radius: 8;
                            -fx-border-radius: 8;
                            -fx-border-color: #ccc;
                            -fx-border-width: 1.5;">
                            <columns>
                                <TableColumn text="ID" prefWidth="60">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="id"/>
                                    </cellValueFactory>
                                </TableColumn>

                                <TableColumn text="Date" prefWidth="180">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="dateReservation"/>
                                    </cellValueFactory>
                                </TableColumn>

                                <TableColumn text="État" prefWidth="120">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="etat"/>
                                    </cellValueFactory>
                                </TableColumn>

                                <TableColumn text="Total" prefWidth="100">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="total"/>
                                    </cellValueFactory>
                                </TableColumn>

                                <TableColumn text="Description" prefWidth="100">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="Description"/>
                                    </cellValueFactory>
                                </TableColumn>
                            </columns>
                        </TableView>

                        <HBox spacing="15" alignment="CENTER">
                            <Button text="Valider" onAction="#validerReservation" style="
                                -fx-background-color: linear-gradient(to right, #4CAF50, #388E3C);
                                -fx-text-fill: white;
                                -fx-font-weight: bold;
                                -fx-background-radius: 8;
                                -fx-padding: 10 30;
                                -fx-cursor: hand;
                                -fx-effect: dropshadow(gaussian, rgba(76, 175, 80, 0.4), 10, 0.3, 0, 2);"
                                    prefWidth="120"/>

                            <Button text="Refuser" onAction="#refuserReservation" style="
                                -fx-background-color: linear-gradient(to right, #F44336, #D32F2F);
                                -fx-text-fill: white;
                                -fx-font-weight: bold;
                                -fx-background-radius: 8;
                                -fx-padding: 10 30;
                                -fx-cursor: hand;
                                -fx-effect: dropshadow(gaussian, rgba(244, 67, 54, 0.4), 10, 0.3, 0, 2);"
                                    prefWidth="120"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- ===== FOOTER ===== -->
    <bottom>
        <VBox alignment="CENTER" style="-fx-padding: 20 0;">
            <Label text="© 2025 - Dashboard Responsable - Tous droits réservés"
                   style="-fx-text-fill: rgba(253, 235, 158, 0.6); -fx-font-size: 12px;"/>
        </VBox>
    </bottom>

</BorderPane>
