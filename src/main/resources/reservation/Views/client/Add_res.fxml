<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="reservation.reservation.controller.ReservationController"
      prefHeight="500.0" prefWidth="600.0"
      style="-fx-background-color: #ffffff; -fx-padding: 20;">

    <!-- Header -->
    <HBox style="-fx-background-color: #000B58; -fx-background-radius: 10 10 0 0; -fx-padding: 15px;"
          alignment="CENTER">
        <Label text="Ajouter une demande d'une reservation"
               style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Formulaire Réservation -->
    <VBox spacing="20" style="-fx-background-color: #f5f5f5; -fx-background-radius: 10; -fx-padding: 30;">

        <!-- Champ Description -->
        <VBox spacing="5">
            <Label text="Description de la Réservation *"
                   style="-fx-text-fill: #003161; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <TextArea fx:id="descriptionField"
                       style="-fx-background-color: white; -fx-border-color: #006A67; -fx-border-radius: 5; -fx-border-width: 2; -fx-padding: 10; -fx-font-size: 14px;"
                       promptText="Entrez description"/>
        </VBox>

        <VBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Salle :"
                   style="-fx-font-size: 14px; -fx-text-fill: #003161; -fx-min-width: 150;"/>
            <ComboBox fx:id="salleComboBox"
                      prefWidth="300"
                      promptText="Sélectionner une salle"
                      style="-fx-font-size: 14px;"/>
        </VBox>

        <!-- Champ Date de réservation -->
        <VBox spacing="5">
            <Label text="Date de Réservation *"
                   style="-fx-text-fill: #003161; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <DatePicker fx:id="datePicker"
                        style="-fx-background-color: white; -fx-border-color: #006A67; -fx-border-radius: 5; -fx-border-width: 2; -fx-padding: 10; -fx-font-size: 14px;"/>
        </VBox>

        <!-- Boutons d'action -->
        <HBox spacing="15" style="-fx-padding: 20 0 0 0;" alignment="CENTER_RIGHT">
            <Button text="Annuler"
                    style="-fx-background-color: #cccccc; -fx-text-fill: #333333; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5;"
                    onAction="#cancelReservation"/>
            <Button text="Ajouter Réservation"
                    style="-fx-background-color: #006A67; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 5;"
                    onAction="#addReservation"/>
        </HBox>

        <!-- Message d'information -->
        <VBox style="-fx-background-color: #FDEB9E; -fx-background-radius: 5; -fx-padding: 10; -fx-margin: 10 0 0 0;">
            <Label text="Information"
                   style="-fx-text-fill: #003161; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Label text="Tous les champs marqués d'un astérisque (*) sont obligatoires."
                   style="-fx-text-fill: #003161; -fx-font-size: 13px; -fx-wrap-text: true;"/>
        </VBox>

    </VBox>

    <!-- Footer -->
    <HBox style="-fx-padding: 15 0 0 0;" alignment="CENTER">
        <Label text="Super User Panel" style="-fx-text-fill: #003161; -fx-font-size: 12px; -fx-opacity: 0.7;"/>
    </HBox>
</VBox>