<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="reservation.reservation.controller.ReservationController"
      stylesheets="@/css/reservation.css"
      spacing="20"
      prefWidth="600"
      style="-fx-background-color: linear-gradient(to bottom right, #FDEB9E, #006A67);">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- ================= HEADER ================= -->
    <HBox alignment="CENTER" styleClass="form-header">
        <Label text="Nouvelle demande de réservation" styleClass="header-title"/>
    </HBox>

    <!-- ================= FORM CARD ================= -->
    <VBox spacing="20" styleClass="card">

        <!-- Description -->
        <VBox spacing="6">
            <Label text="Description *" styleClass="label"/>
            <TextArea fx:id="descriptionField"
                      promptText="Décrivez votre besoin"
                      prefRowCount="3"
                      styleClass="input"/>
        </VBox>

        <!-- Salle -->
        <VBox spacing="6">
            <Label text="Salle *" styleClass="label"/>
            <ComboBox fx:id="salleComboBox"
                      promptText="Sélectionner une salle"
                      styleClass="input"
                      prefWidth="300"/>
        </VBox>

        <!-- Date -->
        <VBox spacing="6">
            <Label text="Date de réservation *" styleClass="label"/>
            <DatePicker fx:id="datePicker" styleClass="input"/>
        </VBox>

        <!-- Buttons -->
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button text="Annuler"
                    onAction="#cancelReservation"
                    styleClass="btn-cancel"/>
            <Button text="Ajouter"
                    onAction="#addReservation"
                    styleClass="btn-primary"/>
        </HBox>

        <!-- Info -->
        <VBox spacing="5" styleClass="info-box">
            <Label text="ℹ Information" styleClass="info-title"/>
            <Label text="Tous les champs marqués par * sont obligatoires."
                   styleClass="info-text"
                   wrapText="true"/>
        </VBox>

    </VBox>

    <!-- ================= FOOTER ================= -->
    <HBox alignment="CENTER">
        <Label text="Reservation System"
               style="-fx-text-fill: #003161; -fx-opacity: 0.6;"/>
    </HBox>

</VBox>
