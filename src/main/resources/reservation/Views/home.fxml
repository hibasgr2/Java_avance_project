<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="reservation.reservation.controller.HomeController"
            stylesheets="@/css/home.css"
            style="-fx-background-color: linear-gradient(to bottom right, #FDEB9E, #006A67);">

    <!-- ================= NAVBAR ================= -->
    <top>
        <HBox spacing="20" styleClass="navbar">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Circle radius="14" fill="#FDEB9E"/>
                <Label text="ReservationApp" styleClass="logo"/>
            </HBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <HBox spacing="15">
                <Button text="Profil" onAction="#showProfile" styleClass="nav-button"/>
                <Button text="Déconnexion" onAction="#handleLogout" styleClass="nav-button"/>
            </HBox>
        </HBox>
    </top>

    <!-- ================= BODY ================= -->
    <center>
        <HBox spacing="30">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <!-- ===== LEFT PANEL ===== -->
            <VBox spacing="20" prefWidth="650" HBox.hgrow="ALWAYS" styleClass="card">

                <!-- USER HEADER -->
                <HBox spacing="15">
                    <Circle radius="25" fill="linear-gradient(to bottom right, #006A67, #003161)"/>
                    <VBox>
                        <Label fx:id="userLabel" text="Bienvenue, User" styleClass="title"/>
                        <Label text="Tableau des réservations" styleClass="subtitle"/>
                    </VBox>
                </HBox>

                <!-- FILTER BUTTONS -->
                <HBox spacing="15">
                    <Button text="Validées" onAction="#showValidees" styleClass="filter-btn"/>
                    <Button text="En attente" onAction="#showAttente" styleClass="filter-btn"/>
                    <Button text="Rejetées" onAction="#showRejetees" styleClass="filter-btn"/>
                </HBox>

                <!-- TABLE -->
<!--                <TableView fx:id="reservationsTable" VBox.vgrow="ALWAYS">-->
<!--                    <columns>-->
<!--                        <TableColumn fx:id="dateColumn" text="Date"/>-->
<!--                        <TableColumn fx:id="etatColumn" text="État"/>-->
<!--                        <TableColumn fx:id="TypeSalleColumn" text="Type de salle"/>-->
<!--                        <TableColumn fx:id="descriptionColumn" text="Description"/>-->
<!--                    </columns>-->
<!--                </TableView>-->
                <TableView fx:id="reservationsTable"
                           VBox.vgrow="ALWAYS"
                           styleClass="modern-table">

                    <columns>
                        <TableColumn fx:id="dateColumn" text="📅 Date" />
                        <TableColumn fx:id="etatColumn" text="🔄 État" />
                        <TableColumn fx:id="TypeSalleColumn" text="🏢 Type de salle" />
                        <TableColumn fx:id="descriptionColumn" text="📝 Description" />
                    </columns>

                </TableView>


            </VBox>

            <!-- ===== RIGHT PANEL ===== -->
            <VBox spacing="25" prefWidth="320">

                <!-- ADD CARD -->
                <VBox spacing="15" alignment="CENTER" styleClass="card">
                    <Circle radius="38" fill="linear-gradient(to bottom right, #000B58, #006A67)"/>
                    <Label text="Nouvelle réservation" styleClass="title"/>
                    <Label text="Créer une nouvelle demande de réservation"
                           styleClass="subtitle"
                           wrapText="true"/>
                    <Button text="➕ Ajouter réservation"
                            onAction="#AddResrvation"
                            styleClass="primary-btn"/>
                </VBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>
